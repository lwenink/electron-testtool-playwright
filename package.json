{
  "name": "playwrapp",
  "version": "0.1.0",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "tsc --watch --project tsconfig.main.json",
    "dev:renderer": "vite",
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "electron": "^32.0.0",
    "playwright": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  }
}
